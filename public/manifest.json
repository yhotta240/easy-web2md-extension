{
  "manifest_version": 3,
  "name": "簡単Webページマークダウン化 - Easy Web to Markdown",
  "version": "0.2.0",
  "description": "WEBページをマークダウン形式に変換してダウンロードします",
  "icons": {
    "48": "icons/icon.png"
  },
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"]
    }
  ]
}
